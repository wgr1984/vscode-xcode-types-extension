{
  "scopeName": "source.xcstrings",
  "patterns": [
    { "name": "comment.line.double-slash.json", "match": "//.*$" },
    { "name": "string.quoted.double.json", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.json", "match": "\\\\." }] },
    { "name": "constant.numeric.json", "match": "\\b-?(0|[1-9]\\d*)(\\.\\d+)?([eE][+-]?\\d+)?\\b" },
    { "name": "constant.language.json", "match": "\\b(true|false|null)\\b" }
  ],
  "repository": {}
}
