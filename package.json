{
  "name": "xcode-types",
  "displayName": "Xcode Types",
  "description": "Table editors and highlighting for plist, strings, xcstrings, xcconfig, plus Asset Catalog viewer",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plist",
        "aliases": [
          "Property List"
        ],
        "extensions": [
          ".plist"
        ]
      },
      {
        "id": "strings",
        "aliases": [
          "Strings"
        ],
        "extensions": [
          ".strings"
        ]
      },
      {
        "id": "xcstrings",
        "aliases": [
          "String Catalog"
        ],
        "extensions": [
          ".xcstrings"
        ]
      },
      {
        "id": "xcconfig",
        "aliases": [
          "Xcode Config"
        ],
        "extensions": [
          ".xcconfig"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "xcodeTypes.table",
        "displayName": "Xcode Types Table",
        "selector": [
          {
            "filenamePattern": "*.plist"
          },
          {
            "filenamePattern": "*.strings"
          },
          {
            "filenamePattern": "*.xcstrings"
          },
          {
            "filenamePattern": "*.xcconfig"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "xcodeTypes.xcassets",
        "displayName": "Asset Catalog",
        "selector": [
          {
            "filenamePattern": "**/*.xcassets/Contents.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "xcodeTypes.openXcassets",
        "title": "Xcode Types: Open Asset Catalog"
      }
    ],
    "keybindings": [
      {
        "command": "xcodeTypes.openXcassets",
        "key": "enter",
        "mac": "enter",
        "when": "filesExplorerFocus && !inputFocus && explorerResourceIsFolder && resourceFilename =~ /\\.xcassets$/"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "xcodeTypes.openXcassets",
          "when": "explorerResourceIsFolder && resourceFilename =~ /\\.xcassets$/",
          "group": "navigation@1"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "**/*.xcassets/Contents.json": "xcodeTypes.xcassets"
      }
    },
    "grammars": [
      {
        "language": "plist",
        "scopeName": "source.plist",
        "path": "./syntaxes/plist.tmLanguage.json"
      },
      {
        "language": "strings",
        "scopeName": "source.strings",
        "path": "./syntaxes/strings.tmLanguage.json"
      },
      {
        "language": "xcstrings",
        "scopeName": "source.xcstrings",
        "path": "./syntaxes/xcstrings.tmLanguage.json"
      },
      {
        "language": "xcconfig",
        "scopeName": "source.xcconfig",
        "path": "./syntaxes/xcconfig.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "vite build -c vite.extension.ts && vite build -c vite.webview.ts && vite build -c vite.xcassets.ts",
    "watch": "vite build -c vite.extension.ts --watch",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "dependencies": {
    "prismjs": "^1.30.0"
  }
}
